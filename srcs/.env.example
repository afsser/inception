# Domain Configuration
DOMAIN_NAME=your_login.42.fr

# SSL Certificate Information
CERT_COUNTRY=BR
CERT_STATE=Your State
CERT_CITY=Your City
CERT_ORG=42 School
CERT_OU=your_login

# MySQL/MariaDB Configuration
MYSQL_DATABASE=wordpress
MYSQL_USER=wpuser
MYSQL_PASSWORD=change_this_password
MYSQL_ROOT_PASSWORD=change_this_root_password

# WordPress Admin Configuration
# Note: Admin username CANNOT contain: admin, Admin, administrator, Administrator
WP_TITLE=Inception Project
WP_ADMIN_USER=your_admin_username
WP_ADMIN_PASSWORD=change_this_admin_password
WP_ADMIN_EMAIL=your_email@student.42.fr

# WordPress Regular User Configuration
WP_USER=subscriber
WP_USER_EMAIL=subscriber@student.42.fr
WP_USER_PASSWORD=change_this_user_password
